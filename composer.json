{
    "name": "webconsulting/webcon-jev",
    "description": "Typed decisions from TypeSafe AI's Jev model inside TYPO3: a native backend module to write and try decisions, a powermail_cond rule operator, and powermail routing that addresses a submission to the right receiver",
    "license": "GPL-2.0-or-later",
    "type": "typo3-cms-extension",
    "keywords": [
        "TYPO3",
        "extension",
        "jev",
        "typesafe",
        "decision",
        "powermail",
        "AI"
    ],
    "authors": [
        {
            "name": "Webconsulting",
            "homepage": "https://github.com/dirnbauer",
            "role": "Maintainer"
        }
    ],
    "homepage": "https://github.com/dirnbauer/typo3-webcon-jev",
    "support": {
        "issues": "https://github.com/dirnbauer/typo3-webcon-jev/issues",
        "source": "https://github.com/dirnbauer/typo3-webcon-jev"
    },
    "require": {
        "php": "^8.4",
        "ext-intl": "*",
        "netresearch/nr-vault": "^0.16 || ^1.0",
        "psr/http-message": "^2.0",
        "psr/log": "^3.0",
        "typo3/cms-backend": "^14.3",
        "typo3/cms-core": "^14.3",
        "typo3/cms-fluid": "^14.3"
    },
    "suggest": {
        "in2code/powermail": "Routes a submission to the receiver a decision names (needs the TYPO3 v14 fork, github.com/dirnbauer/powermail)",
        "in2code/powermail_cond": "Adds Jev rule operators to powermail conditions (needs the TYPO3 v14 fork, github.com/dirnbauer/powermail_cond)"
    },
    "autoload": {
        "psr-4": {
            "Webconsulting\\WebconJev\\": "Classes/"
        }
    },
    "config": {
        "allow-plugins": {
            "phpstan/extension-installer": true,
            "typo3/class-alias-loader": true,
            "typo3/cms-composer-installers": true
        },
        "bin-dir": ".Build/bin",
        "platform": {
            "php": "8.4.1"
        },
        "sort-packages": true,
        "vendor-dir": ".Build/vendor"
    },
    "extra": {
        "typo3/cms": {
            "extension-key": "webcon_jev",
            "web-dir": ".Build/Web"
        }
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/dirnbauer/powermail.git",
            "only": [
                "in2code/powermail"
            ]
        },
        {
            "type": "vcs",
            "url": "https://github.com/dirnbauer/powermail_cond.git",
            "only": [
                "in2code/powermail_cond"
            ]
        }
    ],
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95",
        "in2code/powermail": "^14.0",
        "in2code/powermail_cond": "dev-typo3-v14",
        "phpstan/phpstan": "^2.2",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpunit/phpunit": "^13.3",
        "saschaegerer/phpstan-typo3": "^3.1",
        "typo3/coding-standards": "^0.9",
        "typo3/testing-framework": "^9.7"
    },
    "autoload-dev": {
        "psr-4": {
            "Webconsulting\\WebconJev\\Tests\\": "Tests/"
        }
    },
    "scripts": {
        "ci": [
            "@ci:phpstan",
            "@ci:cgl",
            "@ci:tests"
        ],
        "ci:phpstan": ".Build/bin/phpstan analyse -c phpstan.neon --no-progress --memory-limit=1G",
        "ci:cgl": ".Build/bin/php-cs-fixer fix --dry-run --diff",
        "ci:tests": "php -d memory_limit=1G .Build/bin/phpunit -c Build/phpunit/UnitTests.xml && php -d memory_limit=1G .Build/bin/phpunit -c Build/phpunit/FunctionalTests.xml",
        "ci:tests:unit": "php -d memory_limit=1G .Build/bin/phpunit -c Build/phpunit/UnitTests.xml",
        "ci:tests:functional": "php -d memory_limit=1G .Build/bin/phpunit -c Build/phpunit/FunctionalTests.xml",
        "fix:cgl": ".Build/bin/php-cs-fixer fix"
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
